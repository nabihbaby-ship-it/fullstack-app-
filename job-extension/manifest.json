

{
  "manifest_version": 3,
  "name": "job tracker",
  "version": "1.0",

  "permissions": [
    "storage",
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://*.indeed.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}